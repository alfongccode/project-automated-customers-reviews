{
  "builds": [
    {
      "src": "web/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "../static" }
    },
    {
      "src": "core/asgi.py",
      "use": "@vercel/python",
      "config": { "includeFiles": "static/**" }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "core/asgi.py" },
    { "src": "/admin/(.*)", "dest": "core/asgi.py" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}